SERVICE_DOMAIN=
ORDYN_RELAY_EDGE_HOST=ordyn-edge.example.com
ORDYN_RELAY_SERVICE_CLIENT_ID=replace-with-configured-service-client-id

# Optional self-hosted STUN; publish its UDP port in compose.yml when enabling.
# Configure the public STUN server URL in Ordyn Settings.
ORDYN_RELAY_STUN_ENABLED=false
ORDYN_RELAY_STUN_BIND_ADDRESS=0.0.0.0
ORDYN_RELAY_STUN_PORT=3478
